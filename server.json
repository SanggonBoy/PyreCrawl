{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SanggonBoy/PyreCrawl",
  "title": "PyreCrawl",
  "description": "Web scraping + research toolkit for AI agents: scrape, crawl, monitor URLs with anti-bot bypass.",
  "version": "0.8.1",
  "repository": {
    "url": "https://github.com/SanggonBoy/PyreCrawl",
    "source": "github"
  },
  "websiteUrl": "https://pypi.org/project/pyrecrawl/",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "pyrecrawl",
      "version": "0.8.1",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "valueHint": "serve"
        }
      ]
    }
  ]
}
